{
  "schemaVersion": "physical-envelope-instrument-profiles-v2.1",
  "researchOnly": true,
  "createdDate": "2026-09-13",
  "populationDistributionClaim": false,
  "unit": "mm",
  "schemaNotes": [
    "analysisProfiles always contain six required dimensional fields; radiusMm=null means flat",
    "manufacturerProfiles omit unreported fields and enumerate missingParameters; null is never an unknown radius",
    "Dimensions are nominal; no fabricated instrument covariance or tolerances",
    "assumedParameters marks numerical completion; globalModelAssumptions apply to every analysis profile"
  ],
  "globalModelAssumptions": {
    "equalTemperament": true,
    "straightNutToBridgeCenterlines": true,
    "equalCenterStringSpacing": true,
    "nominalScaleIgnoresIndividualSaddleCompensation": true,
    "constantTransverseRadius": true,
    "actionReliefFretHeightAndStringGaugeNotModeled": true
  },
  "formulas": {
    "fretWireX": "L * (1 - 2 ** (-n / 12))",
    "spreadAtX": "nutOuterStringSpreadMm + (bridgeOuterStringSpreadMm - nutOuterStringSpreadMm) * x / scaleLengthMm",
    "stringY": "(stringIndex / 5 - 0.5) * spreadAtX; index0 high E, index5 low E",
    "surfaceZ": "radiusMm === null ? 0 : sqrt(radiusMm**2-y**2)-radiusMm",
    "adjacentCenterGap": "spreadAtX / 5 only under equal-center assumption, never nutWidthMm/5",
    "fretCellContact": "x in [x(n-1), x(n)]; chosen interior contact point is an additional assumption, not fret wire"
  },
